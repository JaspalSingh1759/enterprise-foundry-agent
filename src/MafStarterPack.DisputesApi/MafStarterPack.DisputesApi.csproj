<Project Sdk="Microsoft.NET.Sdk.Web"><PropertyGroup>  <UserSecretsId>e2ec6bea-dde1-4941-9e42-b2a897f086ab</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MafStarterPack.ServiceDefaults\MafStarterPack.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 40 seed cases and the reference data letters need, from the synthetic bank (tools/synthetic-bank). -->
    <None Include="..\MafStarterPack.McpBanking\data\cases.jsonl;..\MafStarterPack.McpBanking\data\cards.jsonl;..\MafStarterPack.McpBanking\data\customers.jsonl;..\MafStarterPack.McpBanking\data\merchants.jsonl;..\MafStarterPack.McpBanking\data\transactions.jsonl" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The same dispute rules mcp-banking applies; approval limits are enforced from them, never from agent output. -->
    <None Include="..\MafStarterPack.McpBanking\rules\dispute-rules.json" Link="rules\dispute-rules.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The approved customer letters (docs/maple-bank/templates), reviewed by disputes ops through CODEOWNERS. -->
    <None Include="..\..\docs\maple-bank\templates\letter-*.md" Link="templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
