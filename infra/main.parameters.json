{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "agentExists": {
      "value": "${SERVICE_AGENT_RESOURCE_EXISTS=false}"
    },
    "webuiExists": {
      "value": "${SERVICE_WEBUI_RESOURCE_EXISTS=false}"
    },
    "foundryProjectEndpoint": {
      "value": "${FOUNDRY_PROJECT_ENDPOINT}"
    },
    "foundryModel": {
      "value": "${FOUNDRY_MODEL}"
    },
    "todoAgentName": {
      "value": "${TODO_AGENT_NAME=todo-agent}"
    },
    "todoAgentVersion": {
      "value": "${TODO_AGENT_VERSION=1}"
    },
    "mcpTodoFqdn": {
      "value": "${AZURE_RESOURCE_MCP_TODO_FQDN}"
    },
    "username": {
      "value": "${AZURE_USERNAME}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE}"
    }
  }
}
